        "BaseUrl": "http://localhost:11434/v1",
        "Model": "qwen2.5:7b",
        "AllowsCaseData": true,
        "TimeoutSeconds": 300
      },
      {
        "Name": "gemini",
        "Enabled": false,
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "Model": "gemini-2.5-flash",
        "ApiKeyEnvVar": "GEMINI_API_KEY",
        "AllowsCaseData": false
      }
    ]
  }

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Supabase": {
    "Url": "",
    "JwtSecret": ""
  },
  "Quotas": {
    "QuestionsPerDay": 15
  },
